<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:textSize="17sp" android:paddingBottom="12dp"
            android:text="@string/m_welcome" />

        <TextView android:id="@+id/linkLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@+id/link" android:text="@string/m_link_label" android:textSize="16sp" />
        <EditText android:id="@+id/link" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="textUri" android:hint="@string/m_link_hint"
            android:importantForAutofill="no" />

        <Button android:id="@+id/write" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_write" />
        <Button android:id="@+id/stopWriting" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_stop_writing" android:visibility="gone" />
        <Button android:id="@+id/watchHere" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_watch_here" />
        <Button android:id="@+id/watchYoutube" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_watch_youtube" />
        <Button android:id="@+id/load" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_load" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:text="@string/m_saved" android:textSize="19sp"
            android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="6dp" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_saved_empty" />
        <LinearLayout android:id="@+id/savedList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/m_settings" />
        <Button android:id="@+id/sponsor" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sponsor" />
        <Button android:id="@+id/about" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/m_about" />
    </LinearLayout>
</ScrollView>
