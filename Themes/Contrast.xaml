<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High contrast: pure black and white, bright accents -->
    <SolidColorBrush x:Key="MainWindowBg" Color="#000000"/>
    <SolidColorBrush x:Key="WindowBg" Color="#000000"/>
    <SolidColorBrush x:Key="PanelBg" Color="#000000"/>
    <SolidColorBrush x:Key="PanelBg2" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="ControlBg" Color="#000000"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="ApplyBrush" Color="#00FF00"/>
    <SolidColorBrush x:Key="CancelBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFA500"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#FF00FF"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#0000AA"/>
</ResourceDictionary>
