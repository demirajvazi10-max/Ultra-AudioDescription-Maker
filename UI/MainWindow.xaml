<Window x:Class="UltraAudioDescriptionMaker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Ultra Audio Description Maker" Width="1240" Height="800" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource MainWindowBg}" Foreground="{DynamicResource TextPrimary}">
    <DockPanel>
        <!-- the menu is filled in code (both languages, shortcut keys shown next to every command) -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="14"/>

        <!-- status line: everything the program reports is shown here and spoken once -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg2}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="420"/>
                <ColumnDefinition x:Name="VideoColumn" Width="4*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="VideoInfo" Grid.Row="0" Grid.Column="0" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>

            <DockPanel Grid.Row="1" Grid.Column="0">
                <Label x:Name="ListLabel" DockPanel.Dock="Top" Target="{Binding ElementName=LineList}" FontWeight="SemiBold"/>
                <ListBox x:Name="LineList" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- what the screen reader says for each description -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                                               Visibility="{Binding StatusVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- the selected description -->
            <Border Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Padding="10" CornerRadius="4"
                    Background="{DynamicResource PanelBg2}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label x:Name="TimeLabel" Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=TimeBox}"/>
                    <Label x:Name="TextLabel" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Target="{Binding ElementName=TextEdit}"/>
                    <TextBox x:Name="TimeBox" Grid.Row="1" Grid.Column="0" FontFamily="Consolas" VerticalAlignment="Top"/>
                    <TextBox x:Name="TextEdit" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" MinHeight="54"
                             AcceptsReturn="False" SpellCheck.IsEnabled="False"/>
                    <Label x:Name="TimingLabel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Target="{Binding ElementName=TimingBox}"/>
                    <TextBox x:Name="TimingBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,8,0,0">
                <WrapPanel x:Name="ButtonRow"/>
                <!-- long work: step, progress bar and details; F9 says all of it -->
                <Border x:Name="WorkPanel" Visibility="Collapsed" Margin="0,6,0,0" Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource PanelBg2}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="WorkTitle" FontWeight="SemiBold" FontSize="14"/>
                        <ProgressBar x:Name="WorkBar" Height="14" Margin="0,6,0,6" Minimum="0" Maximum="100" Focusable="True"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBg}"
                                     FocusVisualStyle="{StaticResource StrongFocus}"/>
                        <TextBlock x:Name="WorkText" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- the picture; for the screen reader only the position text matters -->
            <DockPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="PositionText" DockPanel.Dock="Bottom" FontFamily="Consolas" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="NowSpeaking" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" TextAlignment="Center"/>
                <Border Background="Black" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                    <vlc:VideoView x:Name="Video" Focusable="False" AutomationProperties.Name="Video"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
